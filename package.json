{
  "name": "init-golang-template",
  "version": "1.0.0",
  "description": "Go project template with linting and commit linting",
  "scripts": {
    "prepare": "bun x --bun husky install",
    "commitlint": "bun x --bun commitlint --edit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7"
  },
  "keywords": [
    "golang",
    "template",
    "linting"
  ],
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  }
}
